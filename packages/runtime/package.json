{
	"name": "@pine/runtime",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"pine-runtime": "./src/cli.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"dev": "tsx src/cli.ts",
		"start": "tsx src/cli.ts",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"smoke": "tsx src/smoke.ts"
	},
	"dependencies": {
		"@pine/agent": "workspace:*",
		"@pine/ai": "workspace:*",
		"@pine/protocol": "workspace:*",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"socket.io-client": "^4.8.3",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	}
}
