{
	"name": "@pine/socket-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Socket.IO server contract for the Pine sidecar. Mirrors @pine/socket-client send/subscribe.",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pine/protocol": "workspace:*",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
