{
	"name": "@pine/agent",
	"version": "0.1.0",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./node": {
			"types": "./src/node.ts",
			"import": "./src/node.ts",
			"default": "./src/node.ts"
		}
	},
	"scripts": {
		"build": "node -e \"process.exit(0)\"",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pine/ai": "workspace:*",
		"@pine/telemetry": "workspace:*",
		"diff": "8.0.4",
		"ignore": "7.0.5",
		"typebox": "1.3.7",
		"yaml": "2.9.0"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@vitest/coverage-v8": "4.1.9",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"private": true
}
