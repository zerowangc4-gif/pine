{
	"name": "@pine/telemetry",
	"version": "0.1.0",
	"private": true,
	"description": "Vendor-neutral telemetry contracts for Pine",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"import": "./src/testing/index.ts",
			"default": "./src/testing/index.ts"
		}
	},
	"scripts": {
		"build": "node -e \"process.exit(0)\"",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
