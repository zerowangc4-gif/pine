{
	"name": "@pine/ai",
	"version": "0.1.0",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./compat": {
			"types": "./src/compat.ts",
			"import": "./src/compat.ts",
			"default": "./src/compat.ts"
		},
		"./providers/*": {
			"types": "./src/providers/*.ts",
			"import": "./src/providers/*.ts",
			"default": "./src/providers/*.ts"
		},
		"./api/*": {
			"types": "./src/api/*.ts",
			"import": "./src/api/*.ts",
			"default": "./src/api/*.ts"
		},
		"./oauth": {
			"types": "./src/oauth.ts",
			"import": "./src/oauth.ts",
			"default": "./src/oauth.ts"
		},
		"./bedrock-provider": {
			"types": "./src/bedrock-provider.ts",
			"import": "./src/bedrock-provider.ts",
			"default": "./src/bedrock-provider.ts"
		},
		"./bun-oauth": {
			"types": "./src/bun-oauth.ts",
			"import": "./src/bun-oauth.ts",
			"default": "./src/bun-oauth.ts"
		}
	},
	"scripts": {
		"build": "node -e \"process.exit(0)\"",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.91.1",
		"@aws-sdk/client-bedrock-runtime": "3.1048.0",
		"@pine/telemetry": "workspace:*",
		"@google/genai": "1.52.0",
		"@smithy/node-http-handler": "4.7.3",
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.6",
		"openai": "6.40.0",
		"partial-json": "0.1.7",
		"typebox": "1.3.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"canvas": "3.2.3",
		"vitest": "4.1.9"
	},
	"private": true
}
