{
	"name": "@pine/socket-client",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Redux-free Socket.IO client for the Pine sidecar. Shared by desktop and future web UI.",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@pine/protocol": "workspace:*",
		"socket.io-client": "^4.8.3"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	}
}
