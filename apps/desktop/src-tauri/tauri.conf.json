{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Pine",
	"version": "0.1.0",
	"identifier": "app.pine.desktop",
	"build": {
		"beforeDevCommand": "pnpm --filter @pine/desktop exec vite --host 127.0.0.1 --port 5173 --strictPort",
		"devUrl": "http://127.0.0.1:5173",
		"beforeBuildCommand": "node ../../scripts/prepare-sidecar.mjs && pnpm --filter @pine/desktop build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Pine",
				"width": 960,
				"height": 720,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"resources": ["resources/runtime/*"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/henry.w@example.net",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"shell": {
			"open": true
		}
	}
}
